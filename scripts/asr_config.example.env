# ============================================================
# 莆仙话 ASR v1 配置模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 asr_config.env
#   2. 按需修改参数值
#   3. 启动服务时加载：source asr_config.env
#
# 或复制到系统 .env 中：
#   cp asr_config.example.env ~/.env
# ============================================================

# ---- ASR 提供方 ----
# mock       — 离线 Mock，固定返回 "春草"（阶段 1 默认）
# thirdparty — 阿里云 DashScope paraformer（阶段 2+）
# local      — 本地莆仙话模型（阶段 6，尚未实现）
ASR_PROVIDER=mock

# ---- DashScope 配置（thirdparty 模式需要）----
# 获取地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=paraformer-realtime-v2

# ---- 文件限制 ----
ASR_MAX_FILE_SIZE_MB=50
ASR_MAX_DURATION_SECONDS=30

# ---- 支持的音频格式 ----
# 逗号分隔，不要加空格
ASR_SUPPORTED_FORMATS=wav,mp3,webm,m4a,ogg

# ---- 语言代码 ----
# auto / putian / xianyou / mandarin
ASR_DEFAULT_LANGUAGE=auto

# ---- 默认场景 ----
# program_search / training / general
ASR_DEFAULT_SCENE=program_search

# ---- 服务端口 ----
ASR_API_PORT=8520
ASR_API_HTTPS_PORT=8521

# ---- 日志级别 ----
# debug / info / warning / error
ASR_LOG_LEVEL=info
